{
  "name": "commentflow",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Instagram comment-to-DM automation using Meta's official Instagram API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web,worker -c blue,magenta,green \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "start:worker": "node dist/worker/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "supertest": "^7.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
